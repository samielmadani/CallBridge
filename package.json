{
  "name": "callbridge",
  "version": "1.0.0",
  "license": "MIT",
  "homepage": "https://github.com/samielmadani/CallBridge",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 8100",
    "serve": "ng serve --host 0.0.0.0 --port 8100",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "ionic:build": "ionic build --prod",
    "ionic:serve": "ng serve --host 0.0.0.0 --port 8100",
    "cap:add": "cap add android",
    "cap:sync": "cap sync android",
    "cap:build": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "cap:run": "cap run android"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^16.2.0",
    "@angular/common": "^16.2.0",
    "@angular/compiler": "^16.2.0",
    "@angular/core": "^16.2.0",
    "@angular/forms": "^16.2.0",
    "@angular/platform-browser": "^16.2.0",
    "@angular/platform-browser-dynamic": "^16.2.0",
    "@angular/router": "^16.2.0",
    "@capacitor/android": "^5.0.6",
    "@capacitor/app": "^5.0.6",
    "@capacitor/browser": "^5.0.6",
    "@capacitor/camera": "^5.0.6",
    "@capacitor/core": "^5.0.6",
    "@capacitor/device": "^5.0.6",
    "@capacitor/haptics": "^5.0.6",
    "@capacitor/keyboard": "^5.0.6",
    "@capacitor/preferences": "^5.0.8",
    "@capacitor/status-bar": "^5.0.6",
    "@ionic/angular": "^7.2.0",
    "cordova-plugin-android-permissions": "^1.1.5",
    "cordova-plugin-inappbrowser": "^6.0.1",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "^0.13.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.0",
    "@angular-eslint/builder": "^16.3.0",
    "@angular-eslint/eslint-plugin": "^16.3.0",
    "@angular-eslint/eslint-plugin-template": "^16.3.0",
    "@angular-eslint/schematics": "^16.3.0",
    "@angular-eslint/template-parser": "^16.3.0",
    "@angular/cli": "^16.2.0",
    "@angular/compiler-cli": "^16.2.0",
    "@capacitor/cli": "^5.0.6",
    "@ionic/angular-toolkit": "^9.0.0",
    "@types/jasmine": "~4.3.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint": "^8.51.0",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.1.6"
  },
  "description": "CallBridge opens FaceTime links and helps Android users join calls."
}
